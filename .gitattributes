# Normalise text to LF in the repo, checked out native on each platform.
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md   text eol=lf

# Binary — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp3 binary
*.ogg binary
*.wav binary
